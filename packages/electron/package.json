{
  "name": "@uswc/electron",
  "version": "0.1.0",
  "private": true,
  "description": "Electron Mac app wrapper for Unconditional Surrender",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "NODE_ENV=development electron dist/main.js",
    "package": "node build.mjs && electron-builder",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "electron": "28.3.3",
    "electron-builder": "24",
    "esbuild": "0.20",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.uswc.unconditional-surrender",
    "productName": "Unconditional Surrender",
    "mac": {
      "category": "public.app-category.games",
      "identity": null,
      "target": [
        { "target": "dir", "arch": ["arm64"] }
      ]
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map"
    ]
  }
}
